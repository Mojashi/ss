{
  "name": "ss",
  "version": "0.4.0",
  "description": "Kimi Code での発言を Slack チャンネルに流す(全文、gitleaks でマスク、AI 応答は載せない)",
  "homepage": "https://github.com/Mojashi/ss",
  "hooks": [
    {
      "event": "UserPromptSubmit",
      "command": "bun --env-file=\"$HOME/.config/ss/env\" ./src/hooks/user-prompt.ts",
      "timeout": 30
    }
  ]
}
